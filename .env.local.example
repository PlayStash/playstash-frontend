# Copy this file to .env.local and fill in the values to enable auto-login in development mode.
VITE_DEV_AUTOLOGIN=false
VITE_DEV_AUTOLOGIN_SERVER=http://localhost:8080
VITE_DEV_AUTOLOGIN_USERNAME=
VITE_DEV_AUTOLOGIN_PASSWORD=

# Optional analytics for your own installation. Leave both unset to disable.
VITE_PLAYSTASH_ANALYTICS_PROJECT_ID=
VITE_PLAYSTASH_ANALYTICS_API_URL=
