{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PlayStash",
  "mainBinaryName": "PlayStash",
  "identifier": "com.playstash.playstash",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PlayStash",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://ipc.localhost http: https: ws: wss:; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: http: https:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: http: https:; font-src 'self' data:; frame-src https://www.youtube.com https://www.youtube-nocookie.com http://127.0.0.1:*; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "appimage", "deb", "rpm"],
    "publisher": "PlayStash",
    "license": "CC BY-NC-SA 4.0",
    "homepage": "https://github.com/PlayStash/playstash-frontend",
    "shortDescription": "The self-hosted gaming platform for DRM-free games",
    "longDescription": "PlayStash is a self-hosted gaming platform for DRM-free games. It acts as a central hub for your game library, keeps metadata and box art up to date, and lets you stream or download your games to any client.",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "desktopTemplate": "linux/playstash.desktop.hbs",
        "section": "games",
        "files": {
          "usr/share/doc/playstash/copyright": "debian-copyright",
          "usr/share/metainfo/com.playstash.playstash.metainfo.xml": "linux/com.playstash.playstash.metainfo.xml",
          "usr/share/doc/playstash/changelog.Debian": "debian-changelog"
        },
        "changelog": "debian-changelog"
      },
      "rpm": {
        "desktopTemplate": "linux/playstash.desktop.hbs",
        "files": {
          "usr/share/metainfo/com.playstash.playstash.metainfo.xml": "linux/com.playstash.playstash.metainfo.xml"
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["playstash"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/PlayStash/playstash-frontend/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
